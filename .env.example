SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8080
SENTINEL_DB_PATH=sentinel.db
SENTINEL_MAX_DIFF_BYTES=1048576
SENTINEL_MAX_STEPS=8
SENTINEL_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
SENTINEL_AUTH_REQUIRED=false
SENTINEL_AUTH_SECRET=
SENTINEL_BOOTSTRAP_ADMIN_USERNAME=
SENTINEL_BOOTSTRAP_ADMIN_PASSWORD=
SENTINEL_DEFAULT_TENANT_ID=default
SENTINEL_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
SENTINEL_LLM_PROVIDER=local

SENTINEL_ENABLED_AGENTS=lead,security,correctness-reliability,critic
SENTINEL_AGENT_TOKEN_BUDGET=8000
SENTINEL_AGENT_TIME_BUDGET_SECONDS=60
# Preflight semantic context budget. Keep input + output below the model window.
SENTINEL_AGENT_CONTEXT_WINDOW_TOKENS=32768
SENTINEL_AGENT_CONTEXT_INPUT_TOKENS=20000
SENTINEL_CONTEXT_DIFF_TOKEN_BUDGET=12000
SENTINEL_CONTEXT_OBSERVATION_TOKEN_BUDGET=4000
SENTINEL_CONTEXT_RECENT_OBSERVATIONS=2
SENTINEL_CONTEXT_MAP_CHUNK_TOKENS=3000
# Configure current provider pricing for non-zero cost accounting in reports.
SENTINEL_LLM_INPUT_COST_PER_MILLION=0
SENTINEL_LLM_OUTPUT_COST_PER_MILLION=0

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
SENTINEL_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
SENTINEL_OPENROUTER_API_KEY=
SENTINEL_OPENROUTER_SITE_URL=
SENTINEL_OPENROUTER_APP_NAME=Sentinel

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_MODEL=

# Replay evaluation and evolution activation gate
SENTINEL_EVAL_MAX_CASES=5
SENTINEL_EVAL_MIN_CASES=3
SENTINEL_EVAL_MIN_HOLDOUT_CASES=2
SENTINEL_EVAL_MIN_IMPROVEMENT=0.01
SENTINEL_EVAL_MAX_METRIC_REGRESSION=0
SENTINEL_EVALUATION_MIN_PUBLIC_PRS=300
SENTINEL_EVALUATION_MIN_F1_IMPROVEMENT=0.03
SENTINEL_EVALUATION_MIN_HIGH_RISK_IMPROVEMENT=0.05

# GitHub integration
SENTINEL_GITHUB_WEBHOOK_SECRET=
SENTINEL_GITHUB_TOKEN=
SENTINEL_AUTO_POST_REVIEW=false
SENTINEL_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
SENTINEL_DATABASE_URL=
SENTINEL_REDIS_URL=
SENTINEL_ASYNC_WORKERS=2
SENTINEL_QUEUE_MAX_ATTEMPTS=3
SENTINEL_QUEUE_LEASE_SECONDS=60
SENTINEL_SKILLS_DIR=skills

# Repair verification and observability
SENTINEL_REPAIR_TEST_COMMAND=
SENTINEL_REPAIR_VERIFY_TIMEOUT_SECONDS=120
SENTINEL_MEMORY_ENABLED=true
SENTINEL_MEMORY_RECALL_LIMIT=6
SENTINEL_MEMORY_WORKING_TTL_SECONDS=86400
SENTINEL_OTEL_ENDPOINT=
SENTINEL_OTEL_SERVICE_NAME=sentinel
SENTINEL_ALERT_FAILURE_RATE=0.20
SENTINEL_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
SENTINEL_GITHUB_APP_ID=
SENTINEL_GITHUB_APP_SLUG=
SENTINEL_GITHUB_PRIVATE_KEY_PATH=
SENTINEL_PUBLIC_BASE_URL=http://127.0.0.1:8080
